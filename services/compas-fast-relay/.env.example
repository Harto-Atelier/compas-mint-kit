# HTTP listener
RELAY_PORT=8787

# Browser origins allowed to call /broadcast. Empty means same-host/server-to-server only.
RELAY_ALLOWED_ORIGINS=http://localhost:3000

# Safety limits
RELAY_CHAIN_ALLOWLIST=1,8453
RELAY_MAX_RAW_BODY_BYTES=65536
RELAY_MAX_TX_COUNT=10
RELAY_CONCURRENCY=4
RELAY_TTL_SECONDS=30
RELAY_LOG_LEVEL=info

# Optional configured transport routes. Only raw signed tx bytes are forwarded.
ROBINHOOD_SEQUENCER_URL=
ALCHEMY_RPC_URL=
QUICKNODE_RPC_URL=

# Optional additional JSON-RPC route array:
# RELAY_ROUTES_JSON=[{"id":"custom","type":"json-rpc","url":"https://example.invalid/rpc"}]
